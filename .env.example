# CretivRank by Cretivra Environment Configuration

PORT=5000

# ----------------------------------------------------
# MONGODB DATABASE CONNECTION
# ----------------------------------------------------
# 1. Local MongoDB Instance:
# MONGODB_URI=mongodb://127.0.0.1:27017/cretivrank
#
# 2. Cloud MongoDB Atlas Instance:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cretivrank?retryWrites=true&w=majority
#
# 3. Development Fallback (Set to 'memory' to use zero-setup in-memory database):
MONGODB_URI=mongodb://127.0.0.1:27017/cretivrank

# ----------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ----------------------------------------------------
JWT_SECRET=cretivrank-super-secret-production-jwt-key-2026
JWT_EXPIRES_IN=24h
CANDIDATE_JWT_SECRET=cretivrank-candidate-assessment-token-secret-2026

# ----------------------------------------------------
# INITIAL ADMIN USER CONFIGURATION
# ----------------------------------------------------
ADMIN_EMAIL=admin@cretivra.com
ADMIN_PASSWORD=password123

# ----------------------------------------------------
# CLOUDINARY CLOUD STORAGE CONFIGURATION
# ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively, set CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

